{
  "name": "arttoy-mysterybox-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "server": "npm --prefix backend run dev",
    "start": "concurrently \"npm run dev:backend\" \"npm run dev\"",
    "build": "npm --prefix frontend run build",
    "cf:deploy": "wrangler pages deploy frontend/dist",
    "d1:init": "npm --prefix backend run d1:init"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "wrangler": "^4.162.0"
  }
}
